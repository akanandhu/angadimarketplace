  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bullmq": "^6.3.15",
    "dotenv": "^18.0.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
