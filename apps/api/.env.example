NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3200,capacitor://localhost,https://localhost

DATABASE_URL=postgresql://angadi:angadi@localhost:5433/angadi
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_HASH_SECRET=change-me-otp

# console | msg91
SMS_PROVIDER=console

AWS_REGION=ap-south-1
S3_BUCKET=angadi-media-dev
# Local S3-compatible storage (leave endpoint/keys empty in AWS to use the task role)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=angadi
S3_SECRET_ACCESS_KEY=angadi-secret
CDN_BASE_URL=http://localhost:9000/angadi-media-dev
MEDIA_LOCAL_PROCESSING=true

# Shared secret for callbacks from the image processor
INTERNAL_API_SECRET=change-me-internal

# Leave empty to log pushes instead of sending through FCM
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: phone (E.164) promoted to ADMIN by the seed script
SEED_ADMIN_PHONE=+919999999999

# Leave empty to disable server-side analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
