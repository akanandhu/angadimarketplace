enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RejectionReason {
  NO_LONGER_AVAILABLE
  NOT_COMFORTABLE_SHARING
  SUSPECTED_SPAM
  OTHER
}

enum CancellationSource {
  BUYER
  SYSTEM
}

/// Listing-contextual request. One PENDING per (buyer, seller, source listing) via partial index.
model ContactRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  buyerId              String               @map("buyer_id") @db.Uuid
  sellerId             String               @map("seller_id") @db.Uuid
  sourceListingId      String               @map("source_listing_id") @db.Uuid
  status               ContactRequestStatus @default(PENDING)
  allowSellerToContact Boolean              @map("allow_seller_to_contact")
  rejectionReason      RejectionReason?     @map("rejection_reason")
  rejectionNote        String?              @map("rejection_note")
  cancellationSource   CancellationSource?  @map("cancellation_source")
  createdAt            DateTime             @default(now()) @map("created_at")
  respondedAt          DateTime?            @map("responded_at")
  cancelledAt          DateTime?            @map("cancelled_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  buyer         User               @relation("BuyerRequests", fields: [buyerId], references: [id])
  seller        User               @relation("SellerRequests", fields: [sellerId], references: [id])
  sourceListing Listing            @relation(fields: [sourceListingId], references: [id])
  connection    ContactConnection?

  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([buyerId, status, createdAt(sort: Desc)])
  @@index([buyerId, sellerId, sourceListingId, createdAt(sort: Desc)])
  @@map("contact_requests")
}

/// Directional Buyer -> Seller approval. Outlives the source listing.
model ContactConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  buyerId               String   @map("buyer_id") @db.Uuid
  sellerId              String   @map("seller_id") @db.Uuid
  createdFromRequestId  String   @unique @map("created_from_request_id") @db.Uuid
  sellerCanContactBuyer Boolean  @map("seller_can_contact_buyer")
  createdAt             DateTime @default(now()) @map("created_at")

  buyer              User           @relation("BuyerConnections", fields: [buyerId], references: [id])
  seller             User           @relation("SellerConnections", fields: [sellerId], references: [id])
  createdFromRequest ContactRequest @relation(fields: [createdFromRequestId], references: [id])

  @@unique([buyerId, sellerId])
  @@index([sellerId])
  @@map("contact_connections")
}
